{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Laravel Server",
            "type": "shell",
            "command": "php artisan serve",
            "options": {
                "cwd": "${workspaceFolder:api}"
            },
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Desktop Terminal",
            "type": "shell",
            "command": "",
            "options": {
                "cwd": "${workspaceFolder:desktop}"
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
